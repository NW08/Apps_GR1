# Copia este archivo como .env y completa los valores. .env NO se versiona.
# Al ejecutar la app se genera src/environments/env.config.ts (tampoco se versiona).

# Supabase > Project Settings > API (Project URL y clave pública "anon").
# Nunca uses aquí la clave "service_role": da acceso total y salta las políticas RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firebase > Configuración del proyecto > General > Tus apps > Configuración del SDK (app web).
# FIREBASE_DATABASE_URL está en Realtime Database (ej. https://<proyecto>-default-rtdb.firebaseio.com).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# URL pública de la app web desplegada (ej. https://<proyecto>.web.app), sin "/" al final.
# Los correos de recuperación de contraseña redirigen aquí; si queda vacía se usa la URL actual.
APP_URL=
