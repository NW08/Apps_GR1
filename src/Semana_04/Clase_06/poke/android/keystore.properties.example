# Plantilla de firma para compilar PokéAPP en modo release.
# 1. Copia este archivo como android/keystore.properties (ya está en .gitignore).
# 2. Completa los valores con los datos de tu keystore. NUNCA subas el archivo real ni el .jks.
# storeFile se resuelve desde android/app/ (ej. ../keystore/pokeapp-release.jks).
storeFile=../keystore/pokeapp-release.jks
storePassword=CAMBIAR
keyAlias=pokeapp
keyPassword=CAMBIAR
