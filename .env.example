# Copia este archivo como .env y completa los valores de tu app web de Firebase:
# Consola de Firebase > Configuración del proyecto > General > Tus apps > Configuración del SDK.
# .env no se versiona. Al ejecutar la app se genera src/environments/firebase.config.ts (tampoco se versiona).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Opcional (Google Analytics)
FIREBASE_MEASUREMENT_ID=
